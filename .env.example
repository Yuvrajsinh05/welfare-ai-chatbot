# Copy to .env.local and fill in. Never commit real values.

# Neon: on Vercel use the "-pooler" connection string (serverless functions open many short connections).
DATABASE_URL=

# Google AI Studio key. The fallback is used when the primary model is overloaded (503) or rate-limited (429).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Signs staff cookies. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Demo staff accounts (alex, bea)
STAFF_A_PASSWORD=
STAFF_B_PASSWORD=
